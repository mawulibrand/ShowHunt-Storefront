{
    "name": "@showhunt/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsc --watch",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "start": "node --env-file=.env dist/main.js",
        "start:worker": "node --env-file=.env dist/worker.js",
        "db:migrate": "node --env-file=.env scripts/migrate.mjs",
        "test": "node --test test/*.test.mjs"
    },
    "dependencies": {
        "@nestjs/common": "12.1.0",
        "@nestjs/core": "12.1.0",
        "@nestjs/platform-express": "12.1.0",
        "@nestjs/swagger": "12.0.2",
        "@showhunt/validation": "workspace:*",
        "@vercel/functions": "3.9.9",
        "pg": "8.23.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/pg": "8.23.1"
    }
}

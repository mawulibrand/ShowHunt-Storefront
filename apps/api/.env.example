NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://showhunt:showhunt_local@localhost:5432/showhunt
# Cloud runtime: Neon pooled URL, with sslmode=verify-full.
# Release migrations: Neon DIRECT URL, with sslmode=verify-full.
# Local migrations fall back to DATABASE_URL when this is empty.
DATABASE_DIRECT_URL=
DB_POOL_MAX=3
